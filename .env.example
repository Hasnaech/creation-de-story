# Clé API Anthropic (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# --- Connexion Instagram (API Instagram Graph) ---
# Nécessite : un compte Instagram Professionnel (Business ou Créateur)
# lié à une Page Facebook, et une app Meta (https://developers.facebook.com)
# Voir le README pour le guide pas à pas.

# Jeton d'accès longue durée (60 jours)
INSTAGRAM_ACCESS_TOKEN=

# ID du compte Instagram professionnel (ex: 17841400000000000)
INSTAGRAM_USER_ID=

# Port du serveur (optionnel)
PORT=3000

# Code d'accès (fortement recommandé si l'app est hébergée en ligne, ex. Vercel).
# S'il est défini, l'interface le demande une fois avant de générer/analyser :
# sans lui, n'importe qui trouvant l'URL consommerait vos crédits API.
# CODE_ACCES=choisissez-un-code
